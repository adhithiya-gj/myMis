generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FileDraft {
  sNo              Int       @id @default(autoincrement())
  dateOfArrival    DateTime
  bank             String
  borrowerName     String
  timeOfArrival    String?
  dateOfCompletion DateTime?
  docTime          String?
  draftedBy        String
  sanSrp           String
  status           String
  remarks          String?
}

model Bank {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model Drafter {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}
